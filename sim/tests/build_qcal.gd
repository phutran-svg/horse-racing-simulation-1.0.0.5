extends SceneTree
## Builds sim/qcal.gd: per course+distance correction for the quick result model (background races),
## so quick results match full-engine races. Reference: 10 equal stat-70 horses with mixed running styles.
const STYLES := ["front", "stalker", "stalker", "mid", "mid", "mid", "closer", "closer", "stalker", "mid"]
const SEEDS := [1, 2, 3]

static func ref_horse(i: int) -> Dictionary:
	var st := {}
	for k in RaceEngine.STATS: st[k] = 70
	return { "id": -100 - i, "name": "ref%d" % i, "gene": "CT", "style": STYLES[i % STYLES.size()], "bw": 480, "carried": 57.0, "jockey": 75, "form": 0, "dirt": 50, "stats": st }

func _init() -> void:
	RaceEngine.ENGINE_K = 1.0
	var lines: PackedStringArray = []
	var t0 := Time.get_ticks_msec()
	var keys: Array = RaceEngine.COURSES.keys()
	keys.sort()
	var spread := []
	for cid in keys:
		for d in RaceEngine.COURSES[cid].distances:
			var field: Array = []
			for i in STYLES.size(): field.append(ref_horse(i))
			var sum := 0.0
			var n := 0
			var wsum := 0.0
			for sd in SEEDS:
				var race := RaceEngine.run_headless(field, { "course": cid, "dist": d, "going": "firm", "seed": sd, "injuries": false, "eiph": false, "risk": 1 })
				var best := INF
				for r in race.runners:
					if r.state == &"fin":
						sum += r.finishT; n += 1; best = minf(best, r.finishT)
				wsum += best
			var mean := sum / n
			RaceEngine.use_course(cid)
			var q := RaceEngine.derive(field[0], { "going": "firm", "dist": d })
			var vq := minf(q.cs / maxf(0.3, 1.0 - (q.d0 + q.gutsRes) / d), q.vmax * 0.955)
			lines.append('\t"%s%d": %.5f,' % [cid, d, mean / (d / vq)])
			spread.append((mean - wsum / SEEDS.size()) / mean)
	var s := 0.0
	for x in spread: s += x
	var f := FileAccess.open("res://sim/qcal.gd", FileAccess.WRITE)
	f.store_string("class_name QCal\nextends RefCounted\n## Generated by sim/tests/build_qcal.gd — quick-model time corrections per course+distance\n## (mean time of 10 equal stat-70 horses in the full engine / simple estimate). Rebuild after engine changes.\nconst T := {\n" + "\n".join(lines) + "\n}\n")
	f.close()
	print("keys ", lines.size(), " ms ", Time.get_ticks_msec() - t0, " mean winner gap %.4f" % (s / spread.size()))
	quit()
